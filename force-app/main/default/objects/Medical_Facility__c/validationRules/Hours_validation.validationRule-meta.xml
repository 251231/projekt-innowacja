<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Hours_validation</fullName>
    <active>false</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Closing_Hours__c)), 
NOT(ISBLANK(Opening_Hours__c)), 
Closing_Hours__c &lt;= Opening_Hours__c)</errorConditionFormula>
    <errorMessage>Closing Hours must be later than Opening Hours.</errorMessage>
</ValidationRule>
